# Keep the models needed by the app and the public WP3 Python default.
# Other trained experiment artifacts remain local and can be regenerated.
/models/*.pkl
/models/*.joblib
!/models/wp1_svm.pkl
!/models/svm_hog.pkl
!/models/svm_hog_lbp.pkl

